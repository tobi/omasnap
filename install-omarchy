#!/usr/bin/env bash
set -euo pipefail

repo_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
prefix="${OMASNAP_PREFIX:-$HOME/.local}"
build_dir="${XDG_CACHE_HOME:-$HOME/.cache}/omasnap/build"

if ! command -v omarchy-pkg-add >/dev/null; then
  printf 'install-omarchy: omarchy-pkg-add is unavailable; this installer requires Omarchy\n' >&2
  exit 1
fi

omarchy-pkg-add \
  base-devel cmake ninja pkgconf qt6-base layer-shell-qt \
  wayland wayland-protocols grim wl-clipboard \
  tesseract tesseract-data-eng tesseract-data-tha

cmake -S "$repo_dir" -B "$build_dir" -G Ninja \
  -DCMAKE_BUILD_TYPE=Release \
  -DCMAKE_INSTALL_PREFIX="$prefix"
cmake --build "$build_dir" --parallel
cmake --install "$build_dir"

rm -f \
  "$prefix/bin/omarchy-capture-editor" \
  "$prefix/share/applications/omarchy-capture-editor.desktop"
rm -rf "$prefix/share/licenses/omarchy-capture-editor"

"$prefix/bin/omasnap" --version
